{
  "name": "trade-logger",
  "version": "0.14.7",
  "description": "Barra per registrare i trade di FX Replay leggendo lo schermo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "installer": "electron-builder --win nsis",
    "installer-mac": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "tesseract.js": "5.1.1",
    "@supabase/supabase-js": "2.45.4",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  },
  "author": "Davide",
  "build": {
    "appId": "it.tradelogger.app",
    "productName": "Trade Logger",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "analyzer.js",
      "autocal.js",
      "store.js",
      "newsfetch.js",
      "news.js",
      "localapi.js",
      "ocr-data/**",
      "ui/**",
      "build/icon.png",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trade Logger",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Trade Logger",
      "artifactName": "Trade-Logger-Setup-${version}.exe"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Trade Logger legge lo schermo per registrare i trade."
      },
      "artifactName": "Trade Logger ${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Trade Logger ${version}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.invalid/aggiornamenti"
      }
    ]
  }
}